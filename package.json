{
  "name": "splicedock",
  "version": "1.1.1",
  "description": "MCP gateway — aggregates MCP servers, HTTP APIs, and CLI tools",
  "type": "module",
  "license": "MIT",
  "author": "Kamil Rybacki",
  "homepage": "https://kamilrybacki.github.io/splice-dock/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamilrybacki/splice-dock.git"
  },
  "bugs": {
    "url": "https://github.com/kamilrybacki/splice-dock/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "agents",
    "llm",
    "cli"
  ],
  "bin": {
    "splicedock": "bin/splicedock.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "scripts/mint",
    "docs/web/examples",
    "splicedock.example.yaml",
    "docs/web/assets/splicedock-mark.svg",
    "docs/web/assets/space-grotesk-latin-{500,700}.woff2",
    "docs/web/assets/space-mono-latin-{400,700}.woff2",
    "docs/web/assets/OFL-Space*.txt"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:functional": "vitest run tests/functional",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/ tests/",
    "lint:layers": "node scripts/check-layers.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/sensible": "^6.0.8",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@simplewebauthn/server": "14.1.0",
    "better-sqlite3": "^13.2.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "js-yaml": "^4.1.0",
    "minimatch": "^11.0.9",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "quickjs-emscripten": "^0.32.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "$minimatch"
  },
  "publishConfig": {
    "access": "public"
  }
}
